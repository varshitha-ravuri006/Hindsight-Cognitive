# Copy to .env (git-ignored) and fill in. Spring loads .env automatically for local runs.
# Never commit real keys.

# Hindsight Cloud API key (https://hindsight.vectorize.io)
HINDSIGHT_API_KEY=
# Memory bank: vishwas-dev while developing, vishwas-demo (a clean bank) for the live demo.
HINDSIGHT_BANK_ID=vishwas-dev

# Groq API key: no-memory baseline, vendor e-mail drafts, assistant tool routing
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional ----------------------------------------------------------------
# Months after which an open mismatch is judged UNRESOLVED_AT_RISK (default 2)
AT_RISK_AFTER_MONTHS=2
# Reflect budget: low | mid | high (low keeps the reconcile step under ~15 s)
REFLECT_BUDGET=low
# Public URL of this deployment; when set, a Hindsight consolidation webhook is registered.
VISHWAS_PUBLIC_BASE_URL=
VISHWAS_WEBHOOK_SECRET=
# PostgreSQL in production (postgres://user:pass@host:5432/db). Empty = local H2 file database.
DATABASE_URL=
# LOG_FORMAT=json for structured JSON logs
LOG_FORMAT=
